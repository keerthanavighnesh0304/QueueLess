# ========================================================
# QueueLess Backend Environment Configuration
# Copy this file to .env and replace placeholders with real values.
# NEVER commit .env to version control.
# ========================================================

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# MySQL Database Configuration
# Format: mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
# For local development, specify discrete DB_* credentials below.
# For Aiven MySQL or cloud instances, you can provide either discrete variables or a complete DATABASE_URL:
# DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?ssl_ca=certs/aiven-ca.pem
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=queueless_db
DATABASE_URL=

# MySQL TLS/SSL Configuration (Required for Aiven and cloud-hosted MySQL)
# Path to the CA certificate file (e.g., certs/aiven-ca.pem or /etc/ssl/certs/ca-certificates.crt)
DB_SSL_CA=
# Verify server certificate hostname (default: true)
DB_SSL_CHECK_HOSTNAME=true
# SSL mode: REQUIRED, VERIFY_CA, VERIFY_IDENTITY (optional when DB_SSL_CA is specified)
DB_SSL_MODE=

# JWT Security
# Generate a secure 32+ character key using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Admin Setup (Used only when running the seed script)
ADMIN_EMAIL=admin@queueless.local
ADMIN_INITIAL_PASSWORD=change_this_secure_admin_password
ADMIN_FULL_NAME=Platform Administrator

# Demo Test Accounts (Used only when running the seed script in development)
DEMO_ACCOUNTS_PASSWORD=change_this_demo_accounts_password

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
