# ========================================================
# QueueLess Frontend Environment Configuration Template
# Copy this file to .env for local development.
# NOTE: Variables exposed to the client bundle must start with VITE_
# NEVER put backend secrets, database passwords, or private keys here.
# ========================================================

# Base URL for the authoritative QueueLess backend API
VITE_API_BASE_URL=http://127.0.0.1:8000/api
